{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BCRM客户管理系统",
  "version": "1.0.0",
  "identifier": "com.bcrm.desktop",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "category": "Business",
    "shortDescription": "BCRM 客户管理系统",
    "longDescription": "大客户 CRM：客户关系网络、组织架构、C74111 诊断、项目作战视图与 62 张业务表的通用数据管理。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
